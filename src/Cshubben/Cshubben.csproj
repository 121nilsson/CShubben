<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged .exe (no MSIX, no Developer Mode required). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RootNamespace>Cshubben</RootNamespace>
    <AssemblyName>Cshubben</AssemblyName>
    <!-- Only English and Swedish translations of the .NET libraries. The rest are tens of MB. -->
    <SatelliteResourceLanguages>en;sv</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <PackageReference Include="Microsoft.UI.Reactor.Advanced" />
    <PackageReference Include="Velopack" />
    <ProjectReference Include="../Cshubben.Core/Cshubben.Core.csproj" />
  </ItemGroup>
</Project>
